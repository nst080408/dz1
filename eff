using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("Решение уровнений");

        //задание 1
        double a1 = 2;
        double b1 = 3;
        double c1 = 4;
        double x1 = 1;

        double part1_num = a1 * Math.Abs(Math.Pow(x1, 3) - b1);
        double part1_den = Math.Sqrt(Math.Pow(x1, 2) + c1);
        double term1 = part1_num / part1_den;
        double term2 = (3.0 / 4.0) * Math.Pow(Math.Sin(x1), 2);
        double y1 = term1 + term2;

        Console.WriteLine($"Задание 1: y = {y1}");



        // задание 2

        double a2 = 3;
        double b2 = 4;
        double c2 = 1;
        double x2 = 2;

        double y2 = (3.0 / 2.0) * a2 * Math.Sqrt(Math.Abs(x2)) + b2 * Math.Log(Math.Abs(Math.Pow(x2, 2) - 1) + 1) + c2 * Math.Cos(x2);

        Console.WriteLine($"Задание 2: y = {y2}");


        //задание 3

        double a3 = 1;
        double b3 = 2;
        double c3 = 3;
        double x3 = -1;

        double num3 = a3 * Math.Pow(x3, 2) + (2.0 / 3.0) * b3 * Math.Abs(x3);
        double den3 = c3 + Math.Sqrt(Math.Pow(x3, 4) + 1);
        double y3 = num3 / den3;

        Console.WriteLine($"Задание 3: y = {y3}");
    }
}

